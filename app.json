{
  "expo": {
    "name": "Tá On Mídia Player",
    "slug": "ta-on-midia-player",
    "version": "2.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#090e1c",
      "resizeMode": "contain"
    },
    "android": {
      "package": "br.com.taonmidia.player",
      "adaptiveIcon": {
        "backgroundColor": "#090e1c"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-av",
      "expo-screen-orientation"
    ]
  }
}
